# Copy to .env / export in the environment. NEVER commit real values.
# Platform HMAC secret (from the dashboard's Rotate Secret; shown once).
AGENT_GAMES_HMAC_SECRET=
# Set to 1 only if the secret above is hex-encoded bytes.
AGENT_GAMES_HMAC_SECRET_HEX=
# Kurier API key for the official zkVerify proof-submission flow.
# Empty = local dev: proofs are generated but NOT submitted (proof_tx null,
# MISSING_VERIFICATION risk logged).
KURIER_API_KEY=
PORT=8791
